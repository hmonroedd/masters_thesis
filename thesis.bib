}
@article{ricapito_tritium_2011,
    title = {Tritium extraction from {LIQUID} {Pb}-{16Li}: {A} critical review of candidate technologies for {ITER} and {DEMO} applications},
    volume = {60},
    shorttitle = {Tritium extraction from {LIQUID} {Pb}-{16Li}},
    doi = {10.13182/FST11-A12621},
    abstract = {Extraction of tritium from liquid lead lithium eutectic alloy is a key topic for the feasibility of any PbLi based tritium breeding blanket (BB). Particularly in DEMO, high trilium extraction efficiency will be required in order to keep low lhe tritium concentration in the Pb-I6Li loop.
This is essential to minimize tritium release into the environmental and tritium permeation from BB into the primary cooling system. In addition, the tritium extraction process needs to be highly reliable in order not lo impact negatively on the operation of the whole fusion reactor, ITER or DEMO.
In the present paper, a critical review of the main candidate technologies for tritium extraction from Pb-16Li, particularly gas liquid contactors and vacuum permeators, is accomplished. The intrinsic limits and possible advantages of these technologies are presented and discussed, in the light of considerations coming directly from mathematical models describing their behaviour as well as from the experimental results so far achieved. Needs in terms of R\&D activilies are identified.},
    journal = {Fusion Science and Technology},
    author = {Ricapito, Italo and Ciampichetti, A. and Laesser, R. and Poitevin, Y. and Utili, M.},
    month = oct,
    year = {2011},
    pages = {1159--1162},
}
@article{alpy_hydrogen_1998,
    title = {Hydrogen extraction from {Pb}–{17Li}: {Tests} with a packed column},
    volume = {39-40},
    issn = {0920-3796},
    shorttitle = {Hydrogen extraction from {Pb}–{17Li}},
    url = {https://www.sciencedirect.com/science/article/pii/S0920379698001422},
